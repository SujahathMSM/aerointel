POSTGRES_DB=aerointel
POSTGRES_USER=aerointel
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432

# Where Postgres lives: "localhost" when the app runs on the host,
# "postgres" when the app runs inside Docker Compose.
POSTGRES_HOST=localhost

# Ollama on the host machine. Inside Docker Compose the API reaches it
# via host.docker.internal (already set in docker-compose.yml).
OLLAMA_BASE_URL=http://localhost:11434

# Redis for rate limiting. Inside Docker Compose the API uses
# redis://redis:6379/0 (already set in docker-compose.yml).
REDIS_URL=redis://localhost:6379/0

# Authentication: /v1/* needs a bearer token from POST /auth/token.
# JWT_SECRET signs the tokens -- required, at least 32 characters. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
# Who may ask for tokens, and what they may do (scopes: query, ingest).
# One line of JSON, single-quoted. Use long random secrets (16+ chars).
AUTH_CLIENTS='{"admin":{"secret":"replace_with_a_long_random_secret","scopes":["query","ingest"]},"reader":{"secret":"replace_with_another_random_secret","scopes":["query"]}}'
# AUTH_ENABLED=true            # false = no tokens needed (local experiments only)
# JWT_TTL_SECONDS=3600

# Idempotency keys on POST /v1/ingest (send an Idempotency-Key header to make retries safe).
# IDEMPOTENCY_ENABLED=true
# IDEMPOTENCY_TTL_SECONDS=86400    # how long finished responses are remembered
# IDEMPOTENCY_LOCK_SECONDS=150     # how long a running request holds its key

# PDF ingestion (POST /v1/documents, scripts/ingest_pdfs.py).
# MAX_UPLOAD_MB=300
# CHUNK_MAX_CHARS=1200             # target chunk size
# CHUNK_OVERLAP_CHARS=150          # repeated at the start of the next chunk
# EMBED_BATCH_SIZE=8               # chunks per Ollama embedding call
# OCR for scanned PDFs: needs tesseract + PyMuPDF (pip install -r requirements-ocr.txt),
# or build the Docker image with INSTALL_OCR=true.
# OCR_ENABLED=false
# OCR_LANGUAGE=eng
# INSTALL_OCR=false                # Docker build option (compose build arg)

# Retrieval switches (docker compose passes these to the API; the eval reads them from here).
# Measure first: python -m evals.doc_eval [--retriever hybrid]
# HYBRID_ENABLED=false             # true = keyword search fused with vector search
# MAX_DISTANCE=0.48                # answer only if the closest chunk is at most this far away
# Context widening: also give the model the chunk(s) that follow each retrieved
# PDF chunk, because an answer often continues after the chunk that matched.
# Measure first: python -m evals.doc_eval --neighbors 1
# A longer prompt needs a bigger window: set LLM_NUM_CTX=8192 when you turn this on.
# CONTEXT_NEIGHBORS=0              # 0 = off
# CONTEXT_MAX_CHUNKS=8             # most chunks in one prompt, hits included
# LLM_NUM_CTX=4096                 # model context window in tokens
# Rate limiting: bursts of RATE_LIMIT_CAPACITY, then REFILL_PER_SECOND sustained.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CAPACITY=20
# RATE_LIMIT_REFILL_PER_SECOND=0.5
# RATE_LIMIT_FAIL_OPEN=true
